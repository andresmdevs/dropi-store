---
import { STORE_NAME, WHATSAPP } from '../config.js';
const { title = STORE_NAME, description = 'Pago contra entrega en toda Colombia. Envíos 24-72h.' } = Astro.props;
const waLink = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(`Hola ${STORE_NAME} 👋 Quiero consultar un pedido por WhatsApp.`)}`;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #070b11;
        --surface: #111825;
        --surface-2: #141c2f;
        --line: #1f2a44;
        --txt: #f6f9ff;
        --muted: #92a7be;
        --brand: #38bdf8;
        --brand-2: #0ea5e9;
        --success: #22c55e;
        --warning: #f59e0b;
        --danger: #ef4444;
        --card: #101827;
        --shadow: 0 24px 60px rgba(3, 13, 33, 0.28);
        --radius: 24px;
      }

      html[data-theme='light'] {
        color-scheme: light;
        --bg: #f5f8ff;
        --surface: #ffffff;
        --surface-2: #f2f6ff;
        --line: #d9e1f2;
        --txt: #0f172a;
        --muted: #5b6d8a;
        --brand: #2563eb;
        --brand-2: #1d4ed8;
        --success: #16a34a;
        --warning: #d97706;
        --danger: #b91c1c;
        --card: #ffffff;
        --shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: var(--bg);
        color: var(--txt);
        font: 16px/1.75 Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      html {
        scroll-behavior: smooth;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      button {
        border: none;
      }

      input,
      select,
      textarea {
        background: var(--surface);
        border: 1px solid var(--line);
        color: var(--txt);
        border-radius: 16px;
        padding: 14px 16px;
        transition: border-color 0.2s ease, background-color 0.2s ease;
      }

      input:focus,
      select:focus,
      textarea:focus,
      button:focus-visible {
        outline: 3px solid rgba(56, 189, 248, 0.35);
        outline-offset: 3px;
      }

      body,
      input,
      select,
      textarea,
      button {
        color: var(--txt);
      }

      main {
        max-width: 1160px;
        margin: 0 auto;
        padding: 24px 20px 96px;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(7, 11, 17, 0.95);
        backdrop-filter: blur(18px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding: 18px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .brand {
        font-weight: 800;
        font-size: 1.2rem;
        letter-spacing: -0.04em;
      }

      .header-meta {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
      }

      .badge,
      .pill,
      .support-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(56, 189, 248, 0.12);
        color: var(--brand);
        border: 1px solid rgba(56, 189, 248, 0.22);
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 0.85rem;
        font-weight: 700;
      }

      .theme-toggle {
        background: var(--surface);
        color: var(--txt);
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: grid;
        place-items: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--brand);
      }

      .hero {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 28px;
        align-items: start;
        margin-bottom: 36px;
      }

      .hero-copy {
        max-width: 620px;
      }

      .hero h1 {
        margin: 18px 0 16px;
        font-size: clamp(2.4rem, 4vw, 4.1rem);
        line-height: 1.02;
      }

      .hero p {
        max-width: 620px;
        color: var(--muted);
        font-size: 1.05rem;
        margin: 0;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 24px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 16px;
        padding: 14px 20px;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        color: #fff;
        box-shadow: 0 20px 55px rgba(56, 189, 248, 0.18);
      }

      .btn-secondary {
        background: transparent;
        color: var(--txt);
        border: 1px solid rgba(255, 255, 255, 0.14);
      }

      .hero-aside {
        display: grid;
        gap: 16px;
      }

      .hero-card,
      .benefit-grid article,
      .review-grid article,
      .faq-grid article,
      .related-grid .card,
      .order-card,
      .steps-grid article {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 28px;
        box-shadow: var(--shadow);
        padding: 24px;
      }

      .hero-card strong,
      .benefit-grid strong,
      .steps-grid strong {
        display: block;
        font-size: 1rem;
        margin-bottom: 12px;
      }

      .hero-card p,
      .benefit-grid p,
      .review-grid p,
      .faq-grid p {
        margin: 0;
        color: var(--muted);
      }

      .section-head {
        display: grid;
        gap: 12px;
        margin-bottom: 18px;
      }

      .section-head.compact {
        margin-bottom: 18px;
      }

      .section-head h2 {
        margin: 0;
        font-size: clamp(1.65rem, 2.2vw, 2.2rem);
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
        max-width: 680px;
      }

      .benefits {
        margin-bottom: 42px;
      }

      .benefit-grid,
      .review-grid,
      .faq-grid,
      .related-grid,
      .featured-grid,
      .steps-grid {
        display: grid;
        gap: 18px;
      }

      .benefit-grid {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }

      .featured-grid {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }

      .review-grid,
      .related-grid {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }

      .faq-grid {
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }

      .steps-grid {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }

      .featured-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .thumb {
        width: 100%;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
      }

      .thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 16px;
        padding: 18px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 30px;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .card:hover {
        transform: translateY(-3px);
        border-color: rgba(56, 189, 248, 0.3);
      }

      .body {
        display: grid;
        gap: 10px;
      }

      .cat {
        color: var(--brand);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
      }

      h3 {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.4;
      }

      .price-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .old-price {
        color: var(--muted);
        text-decoration: line-through;
        font-size: 0.95rem;
      }

      .discount,
      .discount-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(239, 68, 68, 0.12);
        color: var(--danger);
        font-size: 0.85rem;
        font-weight: 700;
      }

      .cta {
        color: var(--brand);
        font-weight: 700;
      }

      .empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 36px 24px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 28px;
      }

      .empty p {
        margin: 0 0 16px;
        color: var(--muted);
      }

      .results {
        margin-top: 16px;
        color: var(--muted);
      }

      .shop-filters {
        margin: 42px 0 24px;
      }

      .search-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px;
        align-items: center;
      }

      .sort-wrap select {
        min-width: 220px;
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 18px;
      }

      .chip {
        appearance: none;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.04);
        color: var(--txt);
        border-radius: 999px;
        padding: 10px 16px;
        cursor: pointer;
        transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
      }

      .chip:hover,
      .chip.active {
        background: rgba(56, 189, 248, 0.16);
        border-color: rgba(56, 189, 248, 0.36);
        transform: translateY(-1px);
      }

      .detail {
        display: grid;
        grid-template-columns: 1.2fr 0.9fr;
        gap: 32px;
        margin-bottom: 42px;
      }

      .gallery {
        display: grid;
        gap: 18px;
      }

      .main-image {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
        border-radius: 30px;
        overflow: hidden;
        background: radial-gradient(circle at top, rgba(56, 189, 248, 0.18), transparent 45%);
        border: 1px solid var(--line);
      }

      .main-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .thumbs {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .thumb-btn {
        width: 72px;
        height: 72px;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid var(--line);
        background: var(--surface);
        padding: 0;
        cursor: pointer;
      }

      .thumb-btn[aria-pressed='true'] {
        border-color: var(--brand);
      }

      .thumb-btn img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .back {
        display: inline-flex;
        margin-bottom: 12px;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .info {
        display: grid;
        gap: 22px;
      }

      .info .cat {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--brand);
      }

      .info h1 {
        margin: 0;
        font-size: clamp(2rem, 3.2vw, 3rem);
      }

      .price-block {
        display: flex;
        gap: 18px;
        align-items: center;
        flex-wrap: wrap;
      }

      .new-price {
        font-size: 2.4rem;
        font-weight: 800;
      }

      .old-price {
        color: var(--muted);
        text-decoration: line-through;
        font-size: 1rem;
      }

      .desc {
        color: var(--muted);
        line-height: 1.85;
        margin: 0;
      }

      .trust-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        background: rgba(56, 189, 248, 0.12);
        color: var(--brand);
        font-size: 0.9rem;
        font-weight: 700;
      }

      .highlight-list h2 {
        margin: 0 0 14px;
        font-size: 1.05rem;
      }

      .highlight-list ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 10px;
      }

      .highlight-list li {
        position: relative;
        padding-left: 28px;
        color: var(--muted);
      }

      .highlight-list li::before {
        content: '•';
        position: absolute;
        left: 0;
        top: 2px;
        color: var(--brand);
      }

      .order-card {
        display: grid;
        gap: 18px;
        border-radius: 28px;
        padding: 24px;
      }

      .order-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
      }

      .order-label {
        margin: 0 0 6px;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .order-card strong {
        font-size: 1.8rem;
      }

      .submit {
        width: 100%;
        margin-top: 4px;
        background: linear-gradient(135deg, #25d366, #1fae4f);
        color: #fff;
        padding: 16px;
        border-radius: 18px;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .submit:hover {
        transform: translateY(-1px);
      }

      .how-it-works {
        margin-top: 42px;
      }

      .how-it-works .section-head {
        margin-bottom: 24px;
      }

      .how-it-works .steps-grid article {
        min-height: 170px;
      }

      .how-it-works article strong {
        font-size: 1.4rem;
        color: var(--brand);
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: rgba(56, 189, 248, 0.12);
      }

      .how-it-works article p {
        margin: 16px 0 0;
        color: var(--muted);
      }

      .related {
        margin-top: 42px;
      }

      @media (max-width: 960px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .detail {
          grid-template-columns: 1fr;
        }

        .search-row {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 720px) {
        main {
          padding: 20px 16px 96px;
        }

        .feature-grid,
        .featured-grid,
        .benefit-grid,
        .review-grid,
        .faq-grid,
        .related-grid,
        .steps-grid {
          gap: 16px;
        }

        .hero p {
          font-size: 1rem;
        }

        .price-row {
          flex-direction: column;
          align-items: flex-start;
        }

        .order-card {
          padding: 20px;
        }
      }

      @media (max-width: 560px) {
        .chips {
          gap: 10px;
        }

        .chip {
          padding: 10px 14px;
          font-size: 0.92rem;
        }

        .hero-actions {
          flex-direction: column;
          align-items: stretch;
        }
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/">🛍️ {STORE_NAME}</a>
      <div class="header-meta">
        <span class="badge">Pago contra entrega</span>
        <span class="badge">Envíos 24-72h</span>
        <button class="theme-toggle" type="button" aria-label="Cambiar tema">🌙</button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <a class="whatsapp-float" href={waLink} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
      <span>WhatsApp</span>
      <strong>Escribe ya</strong>
    </a>

    <footer>Monkey Store · Pago contra entrega en Colombia · Envíos 24-72h</footer>

    <script>
      const button = document.querySelector('.theme-toggle');
      const root = document.documentElement;
      const stored = window.localStorage.getItem('theme');
      const defaultTheme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      root.dataset.theme = defaultTheme;
      button.textContent = defaultTheme === 'light' ? '🌞' : '🌙';
      button.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        window.localStorage.setItem('theme', next);
        button.textContent = next === 'light' ? '🌞' : '🌙';
      });
    </script>
  </body>
</html>
