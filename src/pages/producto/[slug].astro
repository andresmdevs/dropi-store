---
import Base from '../../layouts/Base.astro';
import { products } from '../../data/products.js';
import { WHATSAPP, STORE_NAME } from '../../config.js';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const cop = (n) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(n);
const related = products.filter((item) => item.category === product.category && item.slug !== product.slug).slice(0, 3);

// Solo lo que el navegador necesita para armar el mensaje de WhatsApp.
// `cost`, `margin` y el id de Dropi NO pueden salir al HTML público.
const publicProduct = { slug: product.slug, name: product.name, price: product.price };
// El número tiene que existir como TEXTO: si el cliente copia el pedido y no se abrió
// WhatsApp, sin el número no tiene a dónde pegarlo.
const phoneDisplay = `+${WHATSAPP.slice(0, 2)} ${WHATSAPP.slice(2, 5)} ${WHATSAPP.slice(5, 8)} ${WHATSAPP.slice(8)}`;

// Corta en el límite de palabra: antes quedaban descripciones partidas a mitad
// de sílaba ("...Comp") en la meta description y en la vista previa del enlace.
const summarize = (text, max = 155) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:.]$/, '') + '…';
};
const description = summarize(product.description);
const pageUrl = new URL(`/producto/${product.slug}/`, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  category: product.category,
  image: product.images.map((src) => new URL(src, Astro.site).href),
  offers: {
    '@type': 'Offer',
    url: pageUrl.href,
    price: product.price,
    priceCurrency: 'COP',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: STORE_NAME },
  },
};
---

<Base
  title={`${product.name} · ${STORE_NAME}`}
  description={description}
  image={`/products/${product.slug}-og.jpg`}
  ogType="product"
  hideFloat={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="detail">
    <div class="gallery">
      <div class="main-image">
        <img id="main-img" src={product.image} alt={product.name} width="900" height="900" fetchpriority="high" decoding="async" />
      </div>
      {product.images.length > 1 && (
        <div class="thumbs">
          {product.images.map((src, index) => (
            <button class="thumb-btn" type="button" data-src={src} aria-label={`Ver imagen ${index + 1}`} aria-pressed={index === 0 ? 'true' : 'false'}>
              {/* La miniatura usa la versión de 450px: cargar la de 900px para pintar
                  72x72 desperdicia datos móviles justo donde se decide la compra. */}
              <img src={src.replace('.webp', '-sm.webp')} alt={`${product.name} miniatura ${index + 1}`} width="72" height="72" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="info">
      <a href="/" class="back">← Volver a la tienda</a>
      <span class="cat">{product.category}</span>
      <h1>{product.name}</h1>
      <div class="price-block">
        <div>
          <span class="new-price">{cop(product.price)}</span>
        </div>
      </div>
      <p class="desc">{product.description}</p>
      <div class="trust-chips">
        <span class="pill">Pago al recibir</span>
        <span class="pill">Envío rápido</span>
        <span class="pill">Garantía local</span>
      </div>

      {product.highlights?.length > 0 && (
        <div class="highlight-list">
          <h2>Características</h2>
          <ul>
            {product.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )}

      <div class="pay-note">
        <strong>Pagas {cop(product.price)} al recibir</strong>
        <p>En efectivo o por transferencia al mensajero. No pagas nada por adelantado.</p>
      </div>

      <p class="shipping-hint">
        Enviamos a toda Colombia. El tiempo y las condiciones de entrega pueden variar según tu ciudad; te confirmamos los detalles exactos por WhatsApp antes de despachar.
      </p>

      <aside class="order-card">
        <div class="order-top">
          <div>
            <p class="order-label">Paga contra entrega</p>
            <strong>{cop(product.price)}</strong>
          </div>
          <span class="order-badge">Seguro</span>
        </div>

        <form id="order-form">
          <label>
            Nombre completo
            <input name="name" required autocomplete="name" placeholder="Ej: Mariana G" />
          </label>
          <label>
            Celular
            <input
              name="phone"
              required
              type="tel"
              inputmode="numeric"
              autocomplete="tel"
              pattern="3[0-9]{9}"
              title="Celular colombiano de 10 dígitos que empieza por 3"
              placeholder="Ej: 3001234567"
            />
          </label>
          <label>
            Ciudad
            <input name="city" required autocomplete="address-level2" placeholder="Ej: Barranquilla" />
          </label>
          <label>
            Departamento
            <input name="department" required autocomplete="address-level1" placeholder="Ej: Atlántico" />
          </label>
          <label>
            Dirección
            <input name="address" required autocomplete="street-address" placeholder="Calle 10 # 5-20, barrio" />
          </label>
          <label>
            Notas (color, modelo, referencia)
            <textarea name="notes" rows="3" placeholder="Ej: color negro, envío a oficina"></textarea>
          </label>
          <button type="submit" class="submit">Enviar pedido por WhatsApp</button>
        </form>

        <!-- Respaldo para los navegadores embebidos de TikTok/Instagram, donde el salto
             a WhatsApp puede no ocurrir y el cliente se queda sin ninguna señal. -->
        <div id="wa-backup" hidden>
          <p class="backup-title">¿No se abrió WhatsApp?</p>
          <a id="wa-fallback" class="btn btn-secondary" href="#" rel="noopener">Abrir el chat manualmente</a>
          <button type="button" id="wa-copy" class="btn btn-secondary">Copiar mi pedido</button>
          <p class="backup-note">
            O escríbenos tú al <strong>{phoneDisplay}</strong> y pega ahí tu pedido.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <section class="how-it-works" aria-labelledby="how-title">
    <div class="section-head">
      <span class="eyebrow">Pago contra entrega</span>
      <h2 id="how-title">Cómo funciona en Monkey Store</h2>
    </div>
    <div class="steps-grid">
      <article>
        <strong>1</strong>
        <p>Pides por WhatsApp y confirmamos tu producto y dirección.</p>
      </article>
      <article>
        <strong>2</strong>
        <p>Despachamos con transportadoras nacionales desde Medellín.</p>
      </article>
      <article>
        <strong>3</strong>
        <p>Recibes el producto, lo revisas y pagas en efectivo o Nequi.</p>
      </article>
      <article>
        <strong>4</strong>
        <p>Si algo no está bien, te ayudamos a devolver o cambiar sin líos.</p>
      </article>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <div class="section-head">
        <span class="eyebrow">Productos relacionados</span>
        <h2 id="related-title">También te puede interesar</h2>
      </div>
      <div class="related-grid">
        {related.map((item) => (
          <a class="card" href={`/producto/${item.slug}/`}>
            <div class="thumb"><img src={item.thumb} alt={item.name} width="450" height="450" loading="lazy" decoding="async" /></div>
            <div class="body">
              <span class="cat">{item.category}</span>
              <h3>{item.name}</h3>
              <div class="price-row">
                <strong>{cop(item.price)}</strong>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <script define:vars={{ WHATSAPP, STORE_NAME, product: publicProduct }}>
    document.addEventListener('DOMContentLoaded', () => {
      const mainImg = document.getElementById('main-img');
      const thumbs = Array.from(document.querySelectorAll('.thumb-btn'));

      thumbs.forEach((button) => {
        button.addEventListener('click', () => {
          thumbs.forEach((item) => item.setAttribute('aria-pressed', 'false'));
          button.setAttribute('aria-pressed', 'true');
          mainImg.src = button.dataset.src;
        });
      });

      const form = document.getElementById('order-form');
      const backup = document.getElementById('wa-backup');
      const fallback = document.getElementById('wa-fallback');
      const copyBtn = document.getElementById('wa-copy');

      // La gente escribe "300 123 4567" o "+57 300...". Sin esto el pattern del campo
      // los rechaza y el pedido se traba en el último paso.
      form.phone.addEventListener('input', () => {
        let v = form.phone.value.replace(/\D/g, '');
        if (v.startsWith('57') && v.length > 10) v = v.slice(2);
        form.phone.value = v.slice(0, 10);
      });

      const buildMessage = (data) => {
        const price = new Intl.NumberFormat('es-CO', {
          style: 'currency',
          currency: 'COP',
          maximumFractionDigits: 0,
        }).format(product.price);
        let src = null;
        try { src = sessionStorage.getItem('src'); } catch (e) { /* ignorar */ }
        return (
          `¡Hola ${STORE_NAME}! Quiero pedir este producto con pago contra entrega:\n\n` +
          `🛍️ ${product.name} — ${price}\n` +
          `🔗 ${location.origin}/producto/${product.slug}/\n\n` +
          `👤 ${data.name}\n📱 ${data.phone}\n🏙️ ${data.city}, ${data.department}\n📍 ${data.address}\n` +
          (data.notes ? `📝 ${data.notes}\n` : '') +
          (src ? `📍 Origen: ${src}\n` : '')
        );
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = Object.fromEntries(new FormData(form).entries());
        const message = buildMessage(data);
        const url = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(message)}`;

        // El respaldo usa api.whatsapp.com, una ruta distinta a la que acaba de intentarse:
        // ofrecer el mismo wa.me que no abrió no le sirve de nada al cliente.
        fallback.href = `https://api.whatsapp.com/send?phone=${WHATSAPP}&text=${encodeURIComponent(message)}`;
        copyBtn.onclick = async () => {
          try {
            await navigator.clipboard.writeText(message);
            copyBtn.textContent = 'Pedido copiado';
          } catch (e) {
            copyBtn.textContent = 'Selecciona el texto de arriba y cópialo';
          }
        };

        // Solo se revela si al segundo seguimos aquí: si WhatsApp abrió, el cliente ya se
        // fue y no tiene sentido dejarle "¿No se abrió?" para cuando vuelva.
        const revelar = setTimeout(() => { backup.hidden = false; }, 1000);
        const cancelar = () => { clearTimeout(revelar); backup.hidden = true; };
        addEventListener('pagehide', cancelar, { once: true });
        addEventListener('visibilitychange', () => { if (document.hidden) cancelar(); }, { once: true });

        // Navegación normal en la misma pestaña: window.open queda bloqueado en los
        // navegadores embebidos de TikTok e Instagram, que es de donde viene el tráfico.
        window.location.href = url;
      });
    });
  </script>
</Base>
