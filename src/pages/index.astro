---
import Base from '../layouts/Base.astro';
import { STORE_NAME } from '../config.js';
import { products, categories } from '../data/products.js';

const cop = (n) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(n);
---

<Base title={`${STORE_NAME} · Tienda`}>
  <section class="hero">
    <h1>Productos con entrega a toda Colombia</h1>
    <p>Pagas cuando recibes. Sin tarjetas, sin riesgos.</p>
  </section>

  <div class="controls">
    <input class="search" id="q" type="search" placeholder="🔎 Buscar producto..." aria-label="Buscar" />
    <select id="cat" aria-label="Categoría">
      <option value="">Todas las categorías</option>
      {categories.map((c) => <option value={c}>{c}</option>)}
    </select>
    <select id="sort" aria-label="Ordenar">
      <option value="feat">Destacados</option>
      <option value="asc">Precio: menor a mayor</option>
      <option value="desc">Precio: mayor a menor</option>
    </select>
  </div>

  <section class="grid" id="grid">
    {products.map((p) => (
      <a class="card" href={`/producto/${p.slug}/`} data-name={p.name.toLowerCase()} data-price={p.price} data-cat={p.category}>
        <div class="thumb"><img src={p.images[0]} alt={p.name} loading="lazy" /></div>
        <div class="body">
          <span class="cat">{p.category}</span>
          <h3>{p.name}</h3>
          <div class="price">{cop(p.price)}</div>
          <span class="cta">Ver producto →</span>
        </div>
      </a>
    ))}
    <p class="empty" id="empty" hidden>No encontramos productos con esos filtros.</p>
  </section>

  <script>
    const grid = document.getElementById('grid');
    const empty = document.getElementById('empty');
    const q = document.getElementById('q');
    const cat = document.getElementById('cat');
    const sort = document.getElementById('sort');
    const cards = Array.from(grid.querySelectorAll('.card'));

    function apply() {
      const term = q.value.trim().toLowerCase();
      const category = cat.value;
      let visible = cards.filter((c) => {
        const okText = !term || c.dataset.name.includes(term);
        const okCat = !category || c.dataset.cat === category;
        c.hidden = !(okText && okCat);
        return okText && okCat;
      });
      if (sort.value !== 'feat') {
        visible.sort((a, b) => (Number(a.dataset.price) - Number(b.dataset.price)) * (sort.value === 'asc' ? 1 : -1));
        visible.forEach((c) => grid.insertBefore(c, empty));
      }
      empty.hidden = visible.length > 0;
    }

    q.addEventListener('input', apply);
    cat.addEventListener('change', apply);
    sort.addEventListener('change', apply);
  </script>
</Base>
