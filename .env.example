# ============================================================
#  Copia este archivo como `.env.local` y pega ahí tus valores.
#  `.env.local` está en .gitignore: NUNCA se sube al repo.
# ============================================================

# === Dropi ===
# Genera la llave en: Dropi -> Integraciones -> Generar Token
DROPI_INTEGRATION_KEY=
# URL base de la API. Producción por defecto; usa la de TEST mientras pruebas.
DROPI_API_URL=https://api.dropi.co

# === Supabase ===
# Las PUBLIC_ se exponen al navegador (es seguro: la anon key es pública por diseño).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (escrituras administrativas). NO la pongas con prefijo PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
